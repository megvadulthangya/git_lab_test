+def load_package_list(path: Path) -> list[str]:
+    if not path.exists():
+        print(f"[ERROR] Package list file missing: {path}", file=sys.stderr)
+        sys.exit(2)
+
+    pkgs = []
+    for line in path.read_text().splitlines():
+        line = line.strip()
+        if not line or line.startswith("#"):
+            continue
+        pkgs.append(line)
+
+    return pkgs
+
+PACKAGES_DIR = REPO_ROOT / "packages"
+LOCAL_PACKAGES = load_package_list(PACKAGES_DIR / "local_packages.txt")
+AUR_PACKAGES = load_package_list(PACKAGES_DIR / "aur_packages.txt")
